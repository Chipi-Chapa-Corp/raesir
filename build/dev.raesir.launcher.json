{
  "app-id": "dev.raesir.launcher",
  "runtime": "org.freedesktop.Platform",
  "runtime-version": "25.08",
  "sdk": "org.freedesktop.Sdk",
  "sdk-extensions": ["org.freedesktop.Sdk.Extension.rust-stable"],
  "command": "raesir",
  "branch": "stable",
  "finish-args": [
    "--socket=wayland",
    "--socket=fallback-x11",
    "--socket=pulseaudio",
    "--share=ipc",
    "--share=network",
    "--device=dri",
    "--filesystem=host",
    "--filesystem=~/.var/app",
    "--talk-name=org.freedesktop.Flatpak"
  ],
  "build-options": {
    "append-path": "/usr/lib/sdk/rust-stable/bin",
    "env": {"CARGO_INCREMENTAL": "0", "CARGO_PROFILE_RELEASE_STRIP": "debuginfo", "PYTHONPATH": "/app/lib/build-python"}
  },
  "cleanup": ["/include", "/lib/pkgconfig", "/lib/build-python", "/share/man", "*.a", "*.la"],
  "modules": [
    {
      "name": "python-build-tools",
      "buildsystem": "simple",
      "build-commands": ["pip3 install --no-index --no-deps --no-build-isolation --target=/app/lib/build-python markupsafe-3.0.3.tar.gz jinja2-3.1.6-py3-none-any.whl"],
      "sources": [
        {"type": "file", "url": "https://files.pythonhosted.org/packages/7e/99/7690b6d4034fffd95959cbe0c02de8deb3098cc577c67bb6a24fe5d7caa7/markupsafe-3.0.3.tar.gz", "sha256": "722695808f4b6457b320fdc131280796bdceb04ab50fe1795cd540799ebe1698"},
        {"type": "file", "url": "https://files.pythonhosted.org/packages/62/a1/3d680cbfd5f4b8f15abc1d571870c5fc3e594bb582bc3b64ea099db13e56/jinja2-3.1.6-py3-none-any.whl", "sha256": "85ece4451f492d0c13c5dd7c13a64681a86afae63a5f347908daf103ce6d2f67"}
      ]
    },
    {
      "name": "libass",
      "buildsystem": "meson",
      "config-opts": ["-Ddefault_library=shared", "-Dauto_features=disabled", "-Dfontconfig=enabled", "-Dasm=enabled"],
      "post-install": ["install -Dm644 ../COPYING /app/share/licenses/libass/COPYING"],
      "sources": [{"type": "archive", "url": "https://github.com/libass/libass/releases/download/0.17.4/libass-0.17.4.tar.gz", "sha256": "a886b3b80867f437bc55cff3280a652bfa0d37b43d2aff39ddf3c4f288b8c5a8"}]
    },
    {
      "name": "libplacebo",
      "buildsystem": "meson",
      "config-opts": ["-Ddefault_library=shared", "-Dauto_features=disabled", "-Ddemos=false"],
      "post-install": ["install -Dm644 ../LICENSE /app/share/licenses/libplacebo/LICENSE"],
      "sources": [{"type": "archive", "url": "https://github.com/haasn/libplacebo/archive/refs/tags/v7.349.0.tar.gz", "sha256": "627e32439a0b3d2b90368ead7e919f470ee7446c87cc0f7841bbe319b23aa8b1"}]
    },
    {
      "name": "mpv",
      "buildsystem": "meson",
      "config-opts": ["-Dlibmpv=true", "-Dcplayer=false", "-Dauto_features=disabled", "-Dgl=disabled", "-Dpulse=enabled", "-Dbuild-date=false"],
      "post-install": ["install -Dm644 ../Copyright /app/share/licenses/mpv/Copyright", "install -Dm644 ../LICENSE.GPL /app/share/licenses/mpv/LICENSE.GPL", "install -Dm644 ../LICENSE.LGPL /app/share/licenses/mpv/LICENSE.LGPL"],
      "sources": [{"type": "archive", "url": "https://github.com/mpv-player/mpv/archive/refs/tags/v0.41.0.tar.gz", "sha256": "ee21092a5ee427353392360929dc64645c54479aefdb5babc5cfbb5fad626209"}]
    },
    {
      "name": "raesir",
      "buildsystem": "simple",
      "build-commands": [
        "cargo build --release --locked --offline --package raesir --bin raesir",
        "install -Dm755 target/release/raesir /app/bin/raesir",
        "install -Dm755 build/host-command /app/bin/host-command",
        "for tool in flatpak steam lutris heroic bottles-cli wine wine64 protontricks xdg-open legendary ferestre; do ln -s host-command /app/bin/$tool; done",
        "install -Dm644 build/dev.raesir.launcher.desktop /app/share/applications/dev.raesir.launcher.desktop",
        "install -Dm644 build/dev.raesir.launcher.metainfo.xml /app/share/metainfo/dev.raesir.launcher.metainfo.xml",
        "install -Dm644 build/icon.svg /app/share/icons/hicolor/scalable/apps/dev.raesir.launcher.svg",
        "install -Dm644 build/icon.png /app/share/icons/hicolor/256x256/apps/dev.raesir.launcher.png",
        "install -Dm644 LICENSE /app/share/licenses/dev.raesir.launcher/LICENSE",
        "python3 scripts/collect-licenses.py /app/share/licenses/dev.raesir.launcher/third-party"
      ],
      "sources": [{"type": "dir", "path": "../dist/flatpak-source"}]
    }
  ]
}
