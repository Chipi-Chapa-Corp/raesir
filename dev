#!/usr/bin/env bash
set -euo pipefail
cd -- "$(dirname -- "${BASH_SOURCE[0]}")"

for tool in cargo python3 flock setsid; do
    command -v "$tool" >/dev/null || { echo "Missing development tool: $tool" >&2; exit 127; }
done
target_dir="${CARGO_TARGET_DIR:-$PWD/target}"
mkdir -p -- "$target_dir"
target_dir="$(cd -- "$target_dir" && pwd)"
export CARGO_TARGET_DIR="$target_dir"
exec 9>"$target_dir/.dev.lock"
if ! flock -n 9; then
    echo '[dev] Another ./dev session is already running. Close it before running ./dev again.' >&2
    exit 1
fi

app_pid=
prune_cache() {
    python3 scripts/prune-target.py --target "$target_dir" || true
}
stop() {
    if [[ -n "$app_pid" ]]; then
        # Stop only this run, including any Cargo/compiler children on interruption.
        kill -TERM -- "-$app_pid" 2>/dev/null || true
        for ((attempt = 0; attempt < 50; attempt++)); do
            kill -0 -- "-$app_pid" 2>/dev/null || break
            sleep 0.1
        done
        kill -KILL -- "-$app_pid" 2>/dev/null || true
        wait "$app_pid" || true
        app_pid=
    fi
    prune_cache
}
trap stop EXIT
trap 'exit 130' INT
trap 'exit 143' TERM

prune_cache
printf '[dev] Building and launching Raesir. Run ./dev again after changes.\n'
setsid cargo run --package raesir --bin raesir -- "$@" 9>&- &
app_pid=$!
wait "$app_pid"
