#!/usr/bin/env bash
set -euo pipefail
cd -- "$(dirname -- "${BASH_SOURCE[0]}")"
if ! command -v dx >/dev/null; then
    echo 'Install once: cargo install dioxus-cli --version 0.7.10 --locked' >&2
    exit 127
fi

for tool in python3 flock setsid; do
    command -v "$tool" >/dev/null || { echo "Missing development tool: $tool" >&2; exit 127; }
done
target_dir="${CARGO_TARGET_DIR:-$PWD/target}"
mkdir -p -- "$target_dir"
target_dir="$(cd -- "$target_dir" && pwd)"
exec 9>"$target_dir/.dev.lock"
if ! flock -n 9; then
    echo '[dev] Another ./dev session is already running. Use its terminal to rebuild or quit.' >&2
    exit 1
fi
python3 scripts/prune-target.py --check-session

dev_pid=
cache_pid=
prune_cache() {
    python3 scripts/prune-target.py --target "$target_dir" || true
}
stop() {
    if [[ -n "$dev_pid" ]]; then
        # Background commands can inherit SIGINT as ignored. Give this server
        # its own process group, and stop only that group on restart/exit.
        kill -TERM -- "-$dev_pid" 2>/dev/null || true
        for ((attempt = 0; attempt < 50; attempt++)); do
            kill -0 -- "-$dev_pid" 2>/dev/null || break
            sleep 0.1
        done
        kill -KILL -- "-$dev_pid" 2>/dev/null || true
        wait "$dev_pid" || true
        dev_pid=
    fi
    if [[ -n "$cache_pid" ]]; then
        kill -TERM "$cache_pid" 2>/dev/null || true
        wait "$cache_pid" || true
        cache_pid=
    fi
    prune_cache
}
start() {
    prune_cache
    setsid dx serve --desktop --renderer native --hot-patch --interactive false \
        --session-cache-dir "$target_dir/dx-session" \
        --package raesir --features hot-reload "$@" 9>&- &
    dev_pid=$!
    python3 scripts/prune-target.py --target "$target_dir" --watch "$dev_pid" 9>&- &
    cache_pid=$!
}
trap stop EXIT
trap 'exit 130' INT
trap 'exit 143' TERM

printf '[dev] Saved UI edits hot-patch. r/R: rebuild and restart; q: quit.\n'
start "$@"
while kill -0 "$dev_pid" 2>/dev/null; do
    if [[ -t 0 ]]; then
        if IFS= read -rsn1 -t 0.2 key; then
            case "$key" in
                r|R) stop; start "$@" ;;
                q|Q) exit 0 ;;
            esac
        fi
    else
        sleep 0.2
    fi
done
wait "$dev_pid"
