{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Raesir",
  "version": "0.1.0",
  "identifier": "dev.raesir.launcher",
  "build": {
    "beforeDevCommand": "npm run web:dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run web:build",
    "frontendDist": "../build"
  },
  "app": {
    "windows": [
      {
        "title": "Raesir — Game library",
        "width": 1440,
        "height": 960,
        "minWidth": 800,
        "minHeight": 560,
        "decorations": false,
        "maximized": true,
        "visible": false,
        "backgroundColor": "#101313"
      }
    ],
    "security": {
      "csp": "default-src 'self'; worker-src 'self' blob:; connect-src ipc: http://ipc.localhost; style-src 'self' 'unsafe-inline'; img-src 'self' asset: http://asset.localhost https://asset.localhost data:",
      "assetProtocol": { "enable": true, "scope": ["$APPCACHE/artwork/**"] }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
